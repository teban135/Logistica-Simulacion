"E2_menos_camiones_x50" = "#FF9800",
"E3_demanda_x150" = "#F44336",
"E4_estres_base" = "#9C27B0")
etiquetas_esc <- c("E1_base_x50" = "E1: 10 camiones\n(λ×50)",
"E2_menos_camiones_x50" = "E2: 5 camiones\n(λ×50)",
"E3_demanda_x150" = "E3: 8 camiones\n(λ×150)",
"E4_estres_base" = "E4: 1 camión\n(λ base)")
